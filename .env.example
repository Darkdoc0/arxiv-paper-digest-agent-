# ==============================================================================
# Autonomous arXiv Paper Digest & QA Agent Configuration
# ==============================================================================

# LLM Provider Configuration
# Choose: 'gemini' (default, free-tier Google Gemini) or 'groq' (Groq Llama 3.3)
LLM_PROVIDER=gemini

# Google Gemini API Key (Get free key from https://aistudio.google.com/)
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-2.0-flash

# Groq API Key (Optional alternative, https://console.groq.com/)
GROQ_API_KEY=your_groq_api_key_here
GROQ_MODEL=llama-3.3-70b-versatile

# Embeddings & Vector DB Settings
# Local open-source embeddings (zero API cost, 100% local CPU/GPU execution)
EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2

# Similarity score threshold for RAG QA retrieval (cosine similarity [0.0 - 1.0])
# Any retrieved chunk with similarity below this threshold triggers hallucination refusal
SIMILARITY_THRESHOLD=0.20
